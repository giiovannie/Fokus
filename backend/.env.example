NODE_ENV=development
# Desarrollo: PORT=3000, DB_HOST=localhost y DB_PORT=3306 si quedan vacíos.
# Producción: configurar todos los campos obligatorios, JWT_SECRET de al menos
# 32 caracteres y FRONTEND_URL como origen HTTPS (sin ruta).
PORT=
# Desarrollo: 0. Render: 1 solo para acceso exclusivo por su proxy;
# verificar en staging la cadena X-Forwarded-For antes de habilitar tráfico.
TRUST_PROXY_HOPS=0
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# Producción requiere TLS. Descargar CA de Aiven y montarla como archivo
# fuera del repositorio (por ejemplo, Render Secret File).
DB_SSL=false
DB_SSL_CA_PATH=
JWT_SECRET=
JWT_EXPIRES_IN=
FRONTEND_URL=
# Cloudinary es opcional. true exige la integración al arrancar en producción.
CLOUDINARY_REQUIRED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
